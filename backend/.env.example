# LLM provider: ollama (free, local) | openai (paid) | leave provider empty for fallbacks
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LanguageTool: use public API for free cloud deploy (no Java). Leave empty for local JVM.
# LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check

# Web deploy: serve built React from FastAPI on one port (see DEPLOY.md)
# SERVE_WEB=1

# Server
HOST=127.0.0.1
PORT=8002
DATABASE_PATH=../database/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
